{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sefaria.org/schemas/social/spec.schema.json",
  "title": "spec.md frontmatter",
  "description": "Frontmatter of specs/NNN-slug/spec.md (plan 5.2). Approval is not stored here: it lives in specs/approvals.json, written by `factory approve`. Every scalar is a string (the factory parses frontmatter with the YAML failsafe schema).",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "status", "features", "owner", "surfaces", "risk", "contract_impact"],
  "properties": {
    "id": { "type": "string", "pattern": "^\\d{3}$" },
    "title": { "type": "string", "minLength": 3, "maxLength": 120 },
    "status": { "enum": ["proposed", "draft", "approved", "building", "verified", "shipped"] },
    "features": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^(FEED|ROOM|SHIUR|SESS|IDENT|HOST|API|OPS)-\\d{3}$" }
    },
    "owner": { "type": "string", "minLength": 1 },
    "surfaces": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" } },
    "risk": { "enum": ["normal", "high"] },
    "contract_impact": { "enum": ["none", "host-minor", "host-major", "api-minor", "api-major"] }
  }
}
