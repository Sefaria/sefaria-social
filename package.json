{
  "name": "sefaria-social",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "app",
    "packages/*",
    "harness"
  ],
  "scripts": {
    "dev": "npm run dev -w app",
    "build": "npm run build -w app",
    "typecheck": "npm run typecheck -w app && tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:arch": "vitest run --project architecture",
    "test:all": "vitest run",
    "test:e2e": "npm run build:surface && npm run build:harness && playwright test",
    "factory": "node factory/cli.mjs",
    "atlas:build": "node factory/cli.mjs atlas:build",
    "test:factory": "vitest run --project factory",
    "test:integration": "vitest run --project integration",
    "db:generate": "drizzle-kit generate --config app/drizzle.config.ts",
    "db:migrate": "tsx app/scripts/migrate.ts",
    "api:generate": "tsx app/scripts/openapi.ts",
    "api:breaking": "tsx app/scripts/openapi-breaking.ts",
    "purge-user": "tsx app/scripts/purge-user.ts",
    "smoke:server": "node app/scripts/smoke.mjs",
    "build:surface": "npm run build:surface -w app",
    "build:harness": "npm run build -w @sefaria-social/harness",
    "harness": "npm run serve -w @sefaria-social/harness",
    "test:contract": "vitest run --project contract && npm run check -w @sefaria-social/host-contract"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@vitejs/plugin-react": "^6.1.1",
    "ajv": "^8.20.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "openapi-typescript": "^7.13.0",
    "jsdom": "^27.0.1",
    "prettier": "^3.6.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  }
}
